# =============================================================================
# MESA SYNC AGENT · CONFIGURAÇÃO DA MÁQUINA DO RESTAURANTE (GARÇOM WEB)
# =============================================================================
# Copie este arquivo para "config.env" na máquina onde roda o Garçom Web
# e preencha com os dados locais e a chave do Supabase.
# =============================================================================

# 1. IDENTIFICAÇÃO DO RESTAURANTE
ID_LOJA=10603
NOME_LOJA=WORLD CAFE

# 2. MODO DE CONEXÃO COM O GARÇOM WEB LOCAL
# Opções: MYSQL (conecta direto na porta 3306) ou ODBC (usa fonte de dados do Windows)
CONEXAO_MODO=MYSQL

# --- Se CONEXAO_MODO=MYSQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=garcomweb

# --- Se CONEXAO_MODO=ODBC ---
ODBC_DSN=GarcomWeb
ODBC_USER=
ODBC_PASSWORD=

# 3. NOMES DAS TABELAS NO BANCO DO GARÇOM WEB (Auto-detectado se padrão)
TABELA_VENDAS=gw_vendas_acumulado
TABELA_CAIXA=gw_caixa_detalha_acumulado

# 4. CREDENCIAIS DO SUPABASE (NUVEM MESA INTELLIGENCE)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 5. INTERVALO DE SINCRONIZAÇÃO AO VIVO (EM SEGUNDOS)
SYNC_INTERVAL_SECONDS=10
